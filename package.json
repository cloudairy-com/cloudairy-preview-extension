{
  "name": "Cloudairy",
  "displayName": "Cloudairy",
  "description": "Build, edit, and preview Cloudairy diagrams directly inside Visual Studio Code with an interactive visualization editor.",
  "icon": "resources/cloudairy-logo.png",
  "version": "1.1.3",
  "publisher": "cloudairy",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "keywords": [
    "cloudairy",
    "diagram",
    "diagrams",
    "architecture",
    "architecture diagram",
    "cloud architecture",
    "system design",
    "flowchart",
    "sequence diagram",
    "uml",
    "class diagram",
    "entity relationship diagram",
    "mind map",
    "gantt chart",
    "process diagram",
    "visual editor",
    "diagram editor",
    "developer tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudairy-com/cloudairy-preview-extension.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cld",
    "onLanguage:json",
    "onCommand:cld.preview",
    "onCommand:cld.previewSideBySide"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cld.preview",
        "title": "Cloudairy: Preview Diagram",
        "category": "CLD",
        "icon": "$(preview)"
      },
      {
        "command": "cld.previewSideBySide",
        "title": "Cloudairy: Preview Diagram",
        "category": "CLD",
        "icon": "$(split-horizontal)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .cld",
          "command": "cld.preview",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname == .cld",
          "command": "cld.preview",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "cld.preview",
          "when": "resourceExtname == .cld || activeEditorLangId == cld || activeEditorLangId == json"
        },
        {
          "command": "cld.previewSideBySide",
          "when": "resourceExtname == .cld || activeEditorLangId == cld || activeEditorLangId == json"
        }
      ]
    },
    "languages": [
      {
        "id": "cld",
        "aliases": [
          "CLD",
          "Cloudairy"
        ],
        "extensions": [
          ".cld"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/cloudairy-logo.png",
          "dark": "./resources/cloudairy-logo.png"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "echo 'No compilation needed for JavaScript extension'",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "d3-flextree": "^2.1.2",
    "d3-hierarchy": "^3.1.2",
    "dompurify": "^3.3.2",
    "jsdom": "^28.1.0",
    "lodash": "^4.17.23",
    "mermaid": "^10.9.5"
  }
}